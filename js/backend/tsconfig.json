{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared": ["../shared/src/index"],
      "@shared/*": ["../shared/src/*"],
      "@shared/types": ["../shared/types"]
    }
  },
  "include": [
    "src/**/*",
    "../shared/src/interfaces/**/*.ts",
    "../shared/src/constants/**/*.ts",
    "../shared/src/index.ts",
    "../shared/types.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/__tests__/**"
  ]
}
