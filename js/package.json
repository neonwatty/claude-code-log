{
  "name": "claude-code-log",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build:backend && npm run build:frontend",
    "dev:backend": "ts-node-dev --project backend/tsconfig.json backend/src/server.ts",
    "dev:frontend": "vite",
    "build:backend": "tsc --project backend/tsconfig.json",
    "build:frontend": "vite build",
    "start": "npm run start:backend",
    "start:backend": "NODE_ENV=production node backend/dist/server.js",
    "start:frontend": "npx http-server frontend/dist -p 8080 -g -c-1",
    "prod": "NODE_ENV=production npm run build && concurrently \"npm run start:backend\" \"npm run start:frontend\"",
    "health": "curl -f http://localhost:3001/health || exit 1",
    "prestart": "npm run build && npm run health-check",
    "health-check": "node -e \"process.env.NODE_ENV === 'production' ? console.log('Production mode verified') : process.exit(1)\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run backend/src",
    "test:frontend": "vitest run frontend",
    "test:components": "vitest run frontend --testPathPattern=components",
    "test:styles": "vitest run frontend --testPathPattern=styles",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:prod": "NODE_ENV=production npm run test",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neonwatty/claude-code-log.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/neonwatty/claude-code-log/issues"
  },
  "homepage": "https://github.com/neonwatty/claude-code-log#readme",
  "dependencies": {
    "@lit/reactive-element": "^2.1.1",
    "@types/cors": "^2.8.19",
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.3",
    "@types/marked": "^5.0.2",
    "@types/node": "^24.3.0",
    "@types/prismjs": "^1.26.5",
    "@types/puppeteer": "^7.0.4",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.18.1",
    "chokidar": "^4.0.3",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "d3": "^7.9.0",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "http-server": "^14.1.1",
    "lit": "^3.3.1",
    "lru-cache": "^11.0.2",
    "marked": "^16.1.2",
    "nodemon": "^3.1.10",
    "prismjs": "^1.30.0",
    "puppeteer": "^22.15.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "uuid": "^11.1.0",
    "vite": "^7.1.2",
    "ws": "^8.18.3",
    "zod": "^4.0.17"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@playwright/test": "^1.40.0",
    "@types/compression": "^1.8.1",
    "@types/express-session": "^1.18.2",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "@vitest/coverage-v8": "^3.2.4",
    "@vitest/ui": "^3.2.4",
    "@web/test-runner": "^0.18.0",
    "concurrently": "^9.2.0",
    "eslint": "^8.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.0.0",
    "supertest": "^7.1.4",
    "tsconfig-paths": "^4.2.0",
    "vite-plugin-web-components-hmr": "^0.1.3",
    "vitest": "^3.2.4"
  }
}
