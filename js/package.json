{
  "name": "claude-code-log",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "build": "npm run build:backend && npm run build:frontend",
    "dev:backend": "ts-node-dev backend/src/server.ts",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "build:backend": "tsc --project backend/tsconfig.json",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=unit",
    "test:e2e": "playwright test",
    "lint": "eslint . --ext .ts,.js",
    "lint:fix": "eslint . --ext .ts,.js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "workspaces": [
    "backend",
    "frontend",
    "shared"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/neonwatty/claude-code-log.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/neonwatty/claude-code-log/issues"
  },
  "homepage": "https://github.com/neonwatty/claude-code-log#readme",
  "dependencies": {
    "@lit/reactive-element": "^2.1.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lit": "^3.3.1",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "@playwright/test": "^1.40.0",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0"
  }
}
