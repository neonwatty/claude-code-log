{
  "name": "claude-code-log-ts",
  "version": "1.0.0",
  "description": "TypeScript full-stack application for converting Claude Code transcript JSONL files into readable HTML format",
  "main": "dist/server/index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "nodemon --exec ts-node src/server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:server && npm run build:client",
    "build:server": "tsc -p tsconfig.server.json",
    "build:client": "vite build",
    "start": "node dist/server/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write src/**/*.{ts,tsx,js,jsx}",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "claude",
    "code",
    "log",
    "typescript",
    "lit",
    "express"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.4",
    "chokidar": "^3.5.3",
    "fs-extra": "^11.2.0",
    "path": "^0.12.7",
    "glob": "^10.3.10",
    "marked": "^9.1.6",
    "highlight.js": "^11.9.0",
    "dayjs": "^1.11.10"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.5",
    "@types/glob": "^8.1.0",
    "@types/marked": "^5.0.2",
    "@types/highlight.js": "^10.1.0",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "nodemon": "^3.0.2",
    "concurrently": "^8.2.2",
    "vite": "^5.0.10",
    "@vitejs/plugin-legacy": "^5.2.0",
    "lit": "^3.1.2",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.11",
    "ts-jest": "^29.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
