import { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';
import { fixture, html, expect as wcExpect } from '@open-wc/testing';
import type { SessionContinuation } from './session-continuation.js';
import './session-continuation.js';
import type { ZodSession } from '../../../../shared/src/schemas/index.js';

// Mock WebSocket
class MockWebSocket {
  static CONNECTING = 0;
  static OPEN = 1;
  static CLOSING = 2;
  static CLOSED = 3;
  
  readyState = MockWebSocket.OPEN;
  onopen: ((event: Event) => void) | null = null;
  onclose: ((event: CloseEvent) => void) | null = null;
  onerror: ((event: Event) => void) | null = null;
  onmessage: ((event: MessageEvent) => void) | null = null;
  
  constructor(public url: string) {
    // Simulate connection delay
    setTimeout(() => {
      if (this.onopen) {
        this.onopen(new Event('open'));
      }
    }, 10);
  }
  
  send(data: string): void {
    // Mock send
  }
  
  close(): void {
    this.readyState = MockWebSocket.CLOSED;
    if (this.onclose) {
      this.onclose(new CloseEvent('close'));
    }
  }
}

// Mock fetch
const mockFetch = vi.fn();

const mockSession: ZodSession = {
  id: 'test-session-123',
  projectPath: '/test/project',
  cwd: '/test/project',
  firstTimestamp: '2023-01-01T00:00:00.000Z',
  lastTimestamp: '2023-01-01T01:00:00.000Z',
  totalUsage: {
    input_tokens: 1000,
    output_tokens: 500,
    cache_creation_input_tokens: 200,
    cache_read_input_tokens: 100
  },
  entries: [
    {
      id: 'entry-1',
      type: 'user',
      timestamp: '2023-01-01T00:00:00.000Z',
      message: {
        role: 'user',
        content: [{ type: 'text', text: 'Hello' }]
      }
    },
    {
      id: 'entry-2', 
      type: 'assistant',
      timestamp: '2023-01-01T00:01:00.000Z',
      message: {
        role: 'assistant',
        content: [{ type: 'text', text: 'Hi there!' }]
      }
    }
  ]
};

describe('SessionContinuation', () => {
  let element: SessionContinuation;
  let container: HTMLDivElement;

  beforeEach(async () => {
    // Setup global mocks
    global.WebSocket = MockWebSocket as any;
    global.fetch = mockFetch;
    
    // Reset fetch mock
    mockFetch.mockReset();
    
    // Create element directly
    element = await fixture(html`
      <session-continuation></session-continuation>
    `) as SessionContinuation;
    
    // Set session property after element creation
    element.session = mockSession;
    
    // Wait for element to initialize and render
    await element.updateComplete;
  });

  afterEach(() => {
    // Cleanup
    vi.clearAllMocks();
  });

  describe('Component Initialization', () => {
    it('should render with session data', () => {
      expect(element).toBeDefined();
      expect(element.session).toEqual(mockSession);
      
      const shadowRoot = element.shadowRoot;
      expect(shadowRoot).toBeDefined();
      
      // Check for header
      const header = shadowRoot?.querySelector('.header');
      expect(header).toBeDefined();
      expect(header?.textContent).toContain('Continue Session in Claude Code');
    });

    it('should initialize WebSocket connection', async () => {
      // WebSocket should be created during firstUpdated
      await new Promise(resolve => setTimeout(resolve, 20)); // Wait for async WebSocket init
      
      // Component should have websocket connection
      expect((element as any).websocket).toBeDefined();
      expect((element as any).websocketConnected).toBe(true);
    });

    it('should display session information correctly', () => {
      const shadowRoot = element.shadowRoot!;
      const sessionInfo = shadowRoot.querySelector('.session-info');
      expect(sessionInfo).toBeDefined();
      
      // Check session ID display
      const sessionIdElement = Array.from(shadowRoot.querySelectorAll('.info-value')).find(
        el => el.textContent?.includes(mockSession.id.slice(0, 8))
      );
      expect(sessionIdElement).toBeDefined();
      
      // Check working directory display
      const cwdElement = Array.from(shadowRoot.querySelectorAll('.info-value')).find(
        el => el.textContent?.includes(mockSession.cwd)
      );
      expect(cwdElement).toBeDefined();
    });

    it('should render empty state when no session provided', async () => {
      const emptyElement = await fixture(html`<session-continuation></session-continuation>`) as SessionContinuation;
      await emptyElement.updateComplete;
      
      const shadowRoot = emptyElement.shadowRoot!;
      const emptyState = shadowRoot.querySelector('.empty-state');
      expect(emptyState).toBeDefined();
      expect(emptyState?.textContent || '').toContain('No session selected');
    });
  });

  describe('Status Management', () => {
    it('should start with idle status', () => {
      const shadowRoot = element.shadowRoot!;
      const statusIndicator = shadowRoot.querySelector('.status-indicator');
      expect(statusIndicator?.textContent || '').toContain('Ready');
      
      const statusIcon = shadowRoot.querySelector('.status-icon.idle');
      expect(statusIcon).toBeDefined();
    });

    it('should update status from WebSocket messages', async () => {
      // Simulate WebSocket message
      const mockWebSocket = (element as any).websocket as MockWebSocket;
      const statusMessage = {
        type: 'claude_process_status',
        data: {
          processId: 'process-123',
          state: 'running',
          pid: 12345
        }
      };
      
      if (mockWebSocket.onmessage) {
        mockWebSocket.onmessage(new MessageEvent('message', {
          data: JSON.stringify(statusMessage)
        }));
      }
      
      await element.updateComplete;
      
      const shadowRoot = element.shadowRoot!;
      const statusIndicator = shadowRoot.querySelector('.status-indicator');
      expect(statusIndicator?.textContent || '').toContain('Running');
    });
  });

  describe('Form Interactions', () => {
    it('should update working directory when input changes', async () => {
      const shadowRoot = element.shadowRoot!;
      const workingDirInput = shadowRoot.querySelector('#working-directory') as HTMLInputElement;
      expect(workingDirInput).toBeDefined();
      
      // Simulate user input
      workingDirInput.value = '/new/working/dir';
      workingDirInput.dispatchEvent(new Event('input'));
      
      await element.updateComplete;
      
      // Check that the component state was updated
      expect((element as any).continuationOptions.workingDirectory).toBe('/new/working/dir');
    });

    it('should toggle advanced options', async () => {
      const shadowRoot = element.shadowRoot!;
      const advancedToggle = shadowRoot.querySelector('.advanced-toggle') as HTMLButtonElement;
      expect(advancedToggle).toBeDefined();
      
      // Initially advanced options should be hidden
      expect(element.showAdvancedOptions).toBe(false);
      let advancedOptions = shadowRoot.querySelector('.advanced-options');
      expect(advancedOptions).toBe(null);
      
      // Click toggle
      advancedToggle.click();
      await element.updateComplete;
      
      // Advanced options should now be visible
      expect(element.showAdvancedOptions).toBe(true);
      advancedOptions = shadowRoot.querySelector('.advanced-options');
      expect(advancedOptions).toBeDefined();
    });

    it('should handle checkbox changes', async () => {
      // Show advanced options first
      element.showAdvancedOptions = true;
      await element.updateComplete;
      
      const shadowRoot = element.shadowRoot!;
      const prepareContextCheckbox = shadowRoot.querySelector('#prepare-context') as HTMLInputElement;
      expect(prepareContextCheckbox).toBeDefined();
      
      // Initial state
      expect((element as any).continuationOptions.prepareContext).toBe(true);
      
      // Uncheck the checkbox
      prepareContextCheckbox.checked = false;
      prepareContextCheckbox.dispatchEvent(new Event('change'));
      await element.updateComplete;
      
      expect((element as any).continuationOptions.prepareContext).toBe(false);
    });
  });

  describe('Session Continuation', () => {
    it('should make API request when continuing session', async () => {
      const mockResponse = {
        success: true,
        processId: 'process-123',
        message: 'Session continued successfully',
        claudeProcessUrl: 'http://localhost:3000'
      };
      
      mockFetch.mockResolvedValueOnce({
        ok: true,
        json: () => Promise.resolve(mockResponse)
      });
      
      const shadowRoot = element.shadowRoot!;
      const continueButton = shadowRoot.querySelector('.btn.primary') as HTMLButtonElement;
      expect(continueButton).toBeDefined();
      expect(continueButton.textContent || '').toContain('Continue Session');
      
      // Click continue button
      continueButton.click();
      await new Promise(resolve => setTimeout(resolve, 10)); // Wait for async operation
      await element.updateComplete;
      
      // Check that fetch was called with correct parameters
      expect(mockFetch).toHaveBeenCalledWith(
        '/api/sessions/continue',
        expect.objectContaining({
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            sessionId: mockSession.id,
            sessionPath: mockSession.projectPath,
            workingDirectory: mockSession.cwd,
            command: undefined
          })
        })
      );
      
      // Check that success message is displayed
      const successMessage = shadowRoot.querySelector('.message.success');
      expect(successMessage?.textContent).toBe(mockResponse.message);
    });

    it('should handle API errors gracefully', async () => {
      mockFetch.mockResolvedValueOnce({
        ok: false,
        status: 500,
        statusText: 'Internal Server Error'
      });
      
      const shadowRoot = element.shadowRoot!;
      const continueButton = shadowRoot.querySelector('.btn.primary') as HTMLButtonElement;
      
      continueButton.click();
      await new Promise(resolve => setTimeout(resolve, 10));
      await element.updateComplete;
      
      // Check that error message is displayed
      const errorMessage = shadowRoot.querySelector('.message.error');
      expect(errorMessage?.textContent).toContain('HTTP 500: Internal Server Error');
    });

    it('should disable form when operation is in progress', async () => {
      // Set loading state directly on the component
      (element as any).isLoading = true;
      await element.updateComplete;
      
      const shadowRoot = element.shadowRoot!;
      const continueButton = shadowRoot.querySelector('.btn.primary') as HTMLButtonElement;
      const workingDirInput = shadowRoot.querySelector('#working-directory') as HTMLInputElement;
      
      expect(continueButton.disabled).toBe(true);
      expect(workingDirInput.disabled).toBe(true);
    });
  });

  describe('WebSocket Handling', () => {
    it('should handle WebSocket errors', async () => {
      const mockWebSocket = (element as any).websocket as MockWebSocket;
      
      // Simulate WebSocket error
      if (mockWebSocket.onerror) {
        mockWebSocket.onerror(new Event('error'));
      }
      
      await element.updateComplete;
      
      expect((element as any).websocketConnected).toBe(false);
    });

    it('should cleanup WebSocket on disconnect', () => {
      const mockWebSocket = (element as any).websocket as MockWebSocket;
      const closeSpy = vi.spyOn(mockWebSocket, 'close');
      
      element.disconnectedCallback();
      
      expect(closeSpy).toHaveBeenCalled();
      expect((element as any).websocket).toBe(null);
    });

    it('should handle process output messages', async () => {
      const mockWebSocket = (element as any).websocket as MockWebSocket;
      const consoleSpy = vi.spyOn(console, 'log');
      
      const outputMessage = {
        type: 'claude_process_output',
        data: {
          processId: 'process-123',
          type: 'stdout',
          data: 'Some output from Claude'
        }
      };
      
      if (mockWebSocket.onmessage) {
        mockWebSocket.onmessage(new MessageEvent('message', {
          data: JSON.stringify(outputMessage)
        }));
      }
      
      await element.updateComplete;
      
      expect(consoleSpy).toHaveBeenCalledWith('Claude process output:', outputMessage.data);
      consoleSpy.mockRestore();
    });

    it('should handle process error messages', async () => {
      const mockWebSocket = (element as any).websocket as MockWebSocket;
      
      const errorMessage = {
        type: 'claude_process_error',
        data: {
          processId: 'process-123',
          message: 'Process failed to start'
        }
      };
      
      if (mockWebSocket.onmessage) {
        mockWebSocket.onmessage(new MessageEvent('message', {
          data: JSON.stringify(errorMessage)
        }));
      }
      
      await element.updateComplete;
      
      // Check that error state is updated
      const shadowRoot = element.shadowRoot!;
      const errorElement = shadowRoot.querySelector('.message.error');
      expect(errorElement?.textContent).toBe('Process failed to start');
    });
  });

  describe('Accessibility', () => {
    it('should have proper form labels', () => {
      const shadowRoot = element.shadowRoot!;
      
      const workingDirLabel = shadowRoot.querySelector('label[for="working-directory"]');
      expect(workingDirLabel).toBeDefined();
      expect(workingDirLabel?.textContent).toBe('Working Directory');
      
      const workingDirInput = shadowRoot.querySelector('#working-directory');
      expect(workingDirInput).toBeDefined();
    });

    it('should have proper button attributes', () => {
      const shadowRoot = element.shadowRoot!;
      const continueButton = shadowRoot.querySelector('.btn.primary') as HTMLButtonElement;
      
      expect(continueButton.type).toBe('button');
      expect(continueButton.textContent || '').toContain('Continue Session');
    });

    it('should show proper loading states', async () => {
      (element as any).isLoading = true;
      await element.updateComplete;
      
      const shadowRoot = element.shadowRoot!;
      const continueButton = shadowRoot.querySelector('.btn.primary') as HTMLButtonElement;
      
      expect(continueButton.textContent || '').toContain('🔄');
      expect(continueButton.disabled).toBe(true);
    });
  });

  describe('Responsive Design', () => {
    it('should have responsive CSS classes', () => {
      const shadowRoot = element.shadowRoot!;
      
      // Check that responsive elements exist
      const sessionInfo = shadowRoot.querySelector('.session-info-grid');
      expect(sessionInfo).toBeDefined();
      
      const actionButtons = shadowRoot.querySelector('.action-buttons');
      expect(actionButtons).toBeDefined();
    });
  });

  describe('Token Usage Display', () => {
    it('should format token counts correctly', () => {
      const shadowRoot = element.shadowRoot!;
      
      // Check that token usage is displayed
      const totalTokensElement = Array.from(shadowRoot.querySelectorAll('.info-value')).find(
        el => el.textContent?.includes('1,500') // 1000 + 500 tokens formatted
      );
      expect(totalTokensElement).toBeDefined();
    });
  });

  describe('Edge Cases', () => {
    it('should handle missing session data gracefully', async () => {
      element.session = null;
      await element.updateComplete;
      
      const shadowRoot = element.shadowRoot!;
      const emptyState = shadowRoot.querySelector('.empty-state');
      expect(emptyState).toBeDefined();
    });

    it('should handle network errors', async () => {
      mockFetch.mockRejectedValueOnce(new Error('Network error'));
      
      const shadowRoot = element.shadowRoot!;
      const continueButton = shadowRoot.querySelector('.btn.primary') as HTMLButtonElement;
      
      continueButton.click();
      await new Promise(resolve => setTimeout(resolve, 10));
      await element.updateComplete;
      
      const errorMessage = shadowRoot.querySelector('.message.error');
      expect(errorMessage?.textContent).toContain('Network error');
    });

    it('should validate form properly', async () => {
      // Test with invalid state - manually update the state
      const currentState = (element as any).continuationState;
      (element as any).continuationState = {
        ...currentState,
        continuationStatus: 'running'
      };
      await element.updateComplete;
      
      const shadowRoot = element.shadowRoot!;
      const continueButton = shadowRoot.querySelector('.btn.primary') as HTMLButtonElement;
      expect(continueButton.disabled).toBe(true);
    });
  });
});